# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg-info/
build/
dist/

# ---- Virtual envs ----
.venv/
venv/
env/
ENV/

# ---- PyCharm / IDEs ----
.idea/
*.iml
.vscode/

# ---- Pytest / coverage ----
.pytest_cache/
.coverage
htmlcov/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Secrets ----
.env
*.env
*.key
*.pem

# ---- Data (exclude large files) ----
data/raw/
data/interim/
data/processed/
*.sqlite

# Keep small CSVs if needed for examples
# data/**/*.csv

# ---- Results (SELECTIVE) ----
# Exclude large/generated result artifacts
results/**/plots/
results/**/audit_bundle/
results/**/*.zip
results/**/*.csv
results/**/*.png
results/**/*.jpg
results/**/*.pdf

# Exclude likelihood curves
results/**/ll_*.png

# Include lightweight summaries/reports
!results/**/*.json
!results/**/*.txt
!results/**/README.md

# Keep .gitkeep
!results/.gitkeep